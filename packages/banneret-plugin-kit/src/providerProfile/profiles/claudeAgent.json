      "symbol": "withClaudeAppContext",
      "commit": "c472ab9693",
      "checked": "2026-11-28"
    }
  },
  "instructions": {
    "agentsMd": {
      "value": "fallback",
      "from": ["memory-page"],
      "note": "By default only when no CLAUDE.md, .claude/CLAUDE.md or CLAUDE.local.md is in the start folder or above. Needs 2.1.277 or later. Not available when the built-in AGENTS.md plugin is disabled."
    },
    "nameSetting": {
      "value": {
        "key": "pluginConfigs[\"cc-plugin-agents-md@builtin\"].options.instructionFiles",
        "set": "claude-md-and-agents-md, which reads both",
        "honoredIn": ["~/.claude/settings.json", "a --settings file", "managed settings"],
        "since": "2.1.277"
      },
      "from": ["memory-page"],
      "note": "Ignored in project and local settings. Before 2.1.285 the plugin id was agents-md@builtin."
    },
    "homeFolder": {
      "value": {
        "path": "~/.claude",
        "env": "CLAUDE_CONFIG_DIR"
      },
      "from": ["env-page"],
      "note": "The page says the variable replaces the configuration directory. It does not name CLAUDE.md."
    },
    "managed": {
      "value": {
        "linux": "/etc/claude-code/CLAUDE.md",
        "macos": "/Library/Application Support/ClaudeCode/CLAUDE.md",
        "windows": "C:\\Program Files\\ClaudeCode\\CLAUDE.md"
      },
      "from": ["memory-page"]
    },
    "user": {
      "value": {
        "names": ["CLAUDE.md"],
        "take": "all"
      },
      "from": ["memory-page"]
    },
    "project": {
      "walk": {
        "value": {
          "startsAt": "startFolder",
          "stopsAt": "filesystemRoot"
        },
        "from": ["memory-page"]
      },
      "root": {
        "value": null,
        "from": ["memory-page"],
        "note": "Instruction files are read from every folder above, with no project root."
      },
      "names": {
        "value": {
          "names": ["CLAUDE.md", ".claude/CLAUDE.md", "CLAUDE.local.md"],
          "take": "all"
        },
        "from": ["memory-page"],
        "note": "CLAUDE.local.md comes after CLAUDE.md. The page does not order CLAUDE.md against .claude/CLAUDE.md."
      },
      "fallback": {
        "value": {
          "when": "noPrimaryFileOnTheWalk",
          "names": ["AGENTS.md", ".claude/AGENTS.md"]
        },
        "from": ["memory-page"],
        "note": "The personal and managed CLAUDE.md files do not count. AGENTS.override.md, AGENTS.local.md and files under .agents are never read."
      }
    },
    "subdirectory": {
      "value": {
        "load": "onDemand",
        "names": {
          "names": ["CLAUDE.md", "CLAUDE.local.md"],
          "take": "all"
        },
        "triggers": ["read", "write", "edit"],
        "fallback": {
          "names": ["AGENTS.md"],
          "triggers": ["read"],
          "blockedBy": ["CLAUDE.md", ".claude/CLAUDE.md", "CLAUDE.local.md"]
        },
        "foldersBetween": "notDocumented"
      },
      "from": ["memory-page"]
    },
    "sizeCaps": {
      "user": {
        "limit": {
          "value": {
            "amounts": [
              {
                "amount": 4194304,
                "unit": "bytes"
              }
            ],
            "setting": null
          },
          "from": ["memory-page"],
          "note": "For CLAUDE.md files read at launch. The page advises under 200 lines. It does not say whether an AGENTS.md read directly has the same limit."
        },
        "counts": {
          "value": "eachFile",
          "from": ["memory-page"]
        },
        "over": {
          "value": "skipsFile",
          "from": ["memory-page"]
        }
      },
      "project": {
        "limit": {
          "value": {
            "amounts": [
              {
                "amount": 4194304,
                "unit": "bytes"
              }
            ],
            "setting": null
          },
          "from": ["memory-page"],
          "note": "For CLAUDE.md files read at launch. The page advises under 200 lines. It does not say whether an AGENTS.md read directly has the same limit."
        },
        "counts": {
          "value": "eachFile",
          "from": ["memory-page"]
        },
        "over": {
          "value": "skipsFile",
          "from": ["memory-page"]
        }
      },
      "subdirectory": {
        "limit": {
          "value": {
            "amounts": [
              {
                "amount": 40000,
                "unit": "characters",
                "when": "200K context window"
              },
              {
                "amount": 200000,
                "unit": "characters",
                "when": "1M context window on Claude Opus 4.6 and Claude Sonnet 4.6"
              },
              {
                "amount": 150000,
                "unit": "characters",
                "when": "1M context window on later models"
              }
            ],
            "setting": null
          },
          "from": ["memory-page"],
          "note": "For CLAUDE.md and CLAUDE.local.md in folders below, with their imports. Since 2.1.309."
        },
        "counts": {
          "value": "eachFile",
          "from": ["memory-page"]
        },
        "over": {
          "value": "keepsStart",
          "from": ["memory-page"],
          "note": "A note tells the model to read the rest."
        }
      }
    },
    "precedence": {
      "value": {
        "order": ["managed", "user", "project"],
        "folderOrder": "outermostFirst",
        "onConflict": "notDefined"
      },
      "from": ["memory-page"],
      "note": "All files are joined. The page says the model may pick either of two instructions that disagree."
    },
    "rules": {
      "value": {
        "folders": [
          {
            "level": "user",
            "path": "~/.claude/rules"
          },
          {
            "level": "project",
            "path": ".claude/rules"
          }
        ],
        "pathScopeField": "paths"
      },
      "from": ["memory-page"],
      "note": "Rules without paths load at launch. Rules with paths load when a matching file is read, written or edited."
    },
    "imports": {
      "value": {
        "syntax": "@path",
        "relativeTo": "importingFile",
        "maxDepth": 4,
        "outsideProject": "asksOnce"
      },
      "from": ["memory-page"],
      "note": "Imports in code spans and code blocks are skipped. Imports in the person's own files load without asking, except in Cowork desktop sessions."
    }
  },
  "memory": {
    "learns": {
      "value": true,
      "from": ["memory-page"]
    },
    "onByDefault": {
      "value": true,
      "from": ["memory-page"],
      "note": "In local sessions."
    },
    "writesByItself": {
      "value": true,
      "from": ["memory-page"]
    },
    "location": {
      "value": ["~/.claude/projects/<project>/memory/"],
      "from": ["memory-page"],
      "note": "The autoMemoryDirectory setting moves it. MEMORY.md is read at start, up to 200 lines or 25KB."
    },
    "offAtLaunch": {
      "value": {
        "possible": true,
        "apply": [
          {
            "kind": "env",
            "name": "CLAUDE_CODE_DISABLE_AUTO_MEMORY",
            "value": "1"
          },
          {
            "kind": "setting",
            "key": "autoMemoryEnabled",
            "value": false
          }
        ]
      },
      "from": ["env-page", "settings-page"],
      "note": "The variable beats the setting for one session, in either direction. A settings file's env block can also set the variable."
    }
  },
  "hooks": {
