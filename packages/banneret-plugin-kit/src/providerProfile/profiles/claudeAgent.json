    "blocks": {
      "value": {
        "exitCode": 2,
        "decisions": [
          "PreToolUse: hookSpecificOutput.permissionDecision deny",
          "PermissionRequest: hookSpecificOutput.decision.behavior deny",
          "UserPromptSubmit, PostToolUse, Stop and others: top-level decision block"
        ]
      },
      "from": ["hooks-page"],
      "note": "What exit code 2 does differs by event. PermissionRequest does not read it."
    },
    "ask": {
      "value": "supported",
      "from": ["hooks-page"],
      "note": "In a -p run where nobody can answer, the call is denied."
    },
